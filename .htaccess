# ============================================================
# My Spanish NLV — Apache .htaccess for Hostinger static site
# ============================================================

Options -Indexes

# ─── Charset & MIME ─────────────────────────────────────────
AddDefaultCharset UTF-8
AddType text/html .html
AddType image/svg+xml .svg
AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

# ─── Rewrite Engine ─────────────────────────────────────────
RewriteEngine On

# Force HTTPS and the non-www host (apex is the canonical host)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://myspanishnlv.com%{REQUEST_URI} [R=301,L]

# ─── Content consolidation 301s (duplicate posts merged) ─────
RewriteRule ^blog/183-day-rule-spain-tax(?:\.html|/)?$ /blog/183-day-rule-spain-tax-status.html [R=301,L]
RewriteRule ^blog/nlv-renewal-documents-2026-checklist(?:\.html|/)?$ /blog/nlv-renewal-documents-2026.html [R=301,L]
RewriteRule ^legal/cookie-policy(?:\.html|/)?$ /legal/cookies-policy.html [R=301,L]
RewriteRule ^blog/what-is-modelo-ex01-how-to-fill(?:\.html|/)?$ /blog/what-is-modelo-ex01-how-to-complete.html [R=301,L]

# Insurance consolidation (24 Oct 2026): duplicate insurance posts merged into their retained pages
RewriteRule ^blog/how-much-health-insurance-cost-spain-nlv-2026(?:\.html|/)?$ /blog/how-much-does-nlv-compliant-health-insurance-cost-spain-2026.html [R=301,L]
RewriteRule ^blog/how-much-health-insurance-cost-spain-nlv(?:\.html|/)?$ /blog/how-much-does-nlv-compliant-health-insurance-cost-spain-2026.html [R=301,L]
RewriteRule ^blog/nlv-compliant-health-insurance-plain-english-guide(?:\.html|/)?$ /requirements/health-insurance-requirement.html [R=301,L]
RewriteRule ^blog/nlv-compliant-health-insurance-what-is-plain-english-guide(?:\.html|/)?$ /requirements/health-insurance-requirement.html [R=301,L]
RewriteRule ^blog/nlv-compliant-health-insurance-spain(?:\.html|/)?$ /requirements/health-insurance-requirement.html [R=301,L]
RewriteRule ^blog/health-insurance-spain-nlv-consulate-requirements(?:\.html|/)?$ /requirements/health-insurance-requirement.html [R=301,L]
RewriteRule ^blog/nlv-renewal-health-insurance(?:\.html|/)?$ /renewal/health-insurance-renewal.html [R=301,L]
RewriteRule ^blog/nlv-renewal-health-insurance-policy(?:\.html|/)?$ /renewal/health-insurance-renewal.html [R=301,L]
RewriteRule ^blog/health-insurance-no-copayments-spain(?:\.html|/)?$ /health-insurance/no-copay-health-insurance.html [R=301,L]
RewriteRule ^blog/register-for-spanish-healthcare-nlv-holder(?:\.html|/)?$ /blog/register-spanish-public-healthcare-nlv.html [R=301,L]
RewriteRule ^blog/healthcare-spain-retirees-nlv-access(?:\.html|/)?$ /blog/healthcare-spain-retirees-guide.html [R=301,L]

# Empty consulate guide retired (25 Oct 2026): US applicants are covered by the USA country guide
RewriteRule ^consulates/spanish-consulate-usa-nlv-guide(?:\.html|/)?$ /usa/nlv-from-usa.html [R=301,L]

# ─── Canonical URL format: pages live at /path.html ──────────
# index.html is served at its directory URL (/ , /blog/ …)
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Duplicate country guide retired into the fuller USA guide
RewriteRule ^by-country/from-usa(?:\.html|/)?$ /usa/nlv-from-usa.html [R=301,L]

# Thin country pages retired into the fuller country guides
RewriteRule ^by-country/from-canada(?:\.html|/)?$ /canada/nlv-from-canada.html [R=301,L]
RewriteRule ^by-country/from-australia(?:\.html|/)?$ /australia/nlv-from-australia.html [R=301,L]
RewriteRule ^by-country/from-new-zealand(?:\.html|/)?$ /new-zealand/nlv-from-new-zealand.html [R=301,L]
RewriteRule ^by-country/from-uk(?:\.html|/)?$ /uk/nlv-from-uk.html [R=301,L]
RewriteRule ^by-country/from-south-africa(?:\.html|/)?$ /south-africa/nlv-from-south-africa.html [R=301,L]

# renewal.html merged into the /renewal/ hub (directory index is the canonical URL)
RewriteRule ^renewal\.html$ /renewal/ [R=301,L]

# Hub pages whose name is also a folder (the folder has no index → was 403)
RewriteRule ^(application-process|by-country|compare|for|health-insurance|life-in-spain|requirements|services|tax)/?$ /$1.html [R=301,L]

# Folders without an index page → the page they stand for (was 403)
RewriteRule ^usa/?$ /usa/nlv-from-usa.html [R=301,L]
RewriteRule ^canada/?$ /canada/nlv-from-canada.html [R=301,L]
RewriteRule ^uk/?$ /uk/nlv-from-uk.html [R=301,L]
RewriteRule ^australia/?$ /australia/nlv-from-australia.html [R=301,L]
RewriteRule ^new-zealand/?$ /new-zealand/nlv-from-new-zealand.html [R=301,L]
RewriteRule ^ireland/?$ /ireland/nlv-from-ireland.html [R=301,L]
RewriteRule ^south-africa/?$ /south-africa/nlv-from-south-africa.html [R=301,L]
RewriteRule ^hong-kong/?$ /hong-kong/nlv-from-hong-kong.html [R=301,L]
RewriteRule ^singapore/?$ /singapore/nlv-from-singapore.html [R=301,L]
RewriteRule ^uae/?$ /uae/nlv-from-uae.html [R=301,L]
RewriteRule ^legal/?$ /legal/legal-statement.html [R=301,L]

# ─── Clean URLs: trailing slash → .html ──────────────────────
# /page/ → /page.html  (if .html file exists and /page/ is not a real dir)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ /$1.html [R=301,L]

# Also handle /page (no trailing slash, no extension)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ /$1.html [L]

# ─── 404 ────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ─── Security Headers ────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS — enable after SSL confirmed live
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ─── Cache Control ───────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html             "access plus 1 hour"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/x-icon          "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ─── Compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json application/manifest+json
</IfModule>

# ─── Block junk/dev files from being served ──────────────────
# Draft content kept for reference only — never public
RewriteRule ^content-recovery(?:/|$) - [F,L]
<FilesMatch "\.(py|sh|md|xlsx|docx|json\.bak)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(TEMPLATE|MASTER|BLOG-TEMPLATE|template-master|rebuild_|batch_|enhance_|expand_|upgrade_|extract_|apply-template)">
  Require all denied
</FilesMatch>
